#!/usr/bin/env bash
# Pre-commit hook: валидация frontmatter скиллов skills_hermes.
# Установка — `make hooks-install` (git config core.hooksPath skills_hermes/hooks).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
git diff --cached --name-only | grep -q '^skills_hermes/' || exit 0

PY=python3
[ -x "$ROOT/venv/bin/python" ] && PY="$ROOT/venv/bin/python"
exec "$PY" "$ROOT/skills_hermes/scripts/validate_skills.py"
