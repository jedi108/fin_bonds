# Это пример файла для хранения секретных данных.
# Скопируйте этот файл в .env и замените значение на ваш реальный токен.
# Убедитесь, что файл .env добавлен в .gitignore, чтобы случайно не опубликовать ваши ключи.

# TBank API токены
INVEST_TOKEN=""

# Счета T-Bank через запятую; пусто = все счета токена
# Список id можно получить: python3 main.py test-tbank accounts
TBANK_ACCOUNT_IDS=""

# Telegram уведомления
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# PostgreSQL — прод-БД (миграции схемы: python3 main.py migrate-db)
# ВАЖНО (решение 017): с dev-машины прод-БД напрямую НЕ доступна —
# «локальный CLI против прод-БД не поддерживается», путь — только ssh на
# хост деплоя (см. make ssh / make run-remote). Значение хранится в
# SOPS-мастере (workspace/fin_bonds/env/.env.prod.enc) и доставляется на
# хост через `make env-push`: оно должно быть валидным с точки зрения
# ХОСТА (postgres слушает только loopback хоста деплоя), а не локальной
# машины — локальный прогон команд к БД падает предсказуемо, это норма.
# Формат (ровно одна схема; не postgres://postgresql://...):
#   postgresql://user:password@host:5432/dbname
POSTGRES_DSN=""

# Тестовая база PostgreSQL для тестов (make test / pytest) — не прод!
# Формат: postgresql://user:password@host:port/dbname_test
#POSTGRES_DSN_TEST="postgresql://user:password@localhost:5432/fin_bonds_test"